<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hust.soict.elitech.aims.gui.controller.CartController">
    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #f0f0f0;">
            <Label text="Shopping Cart" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label text="Review your items before checkout" style="-fx-font-size: 12; -fx-text-fill: #666666;"/>
        </VBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 15;">
            <VBox fx:id="cartItemsVBox" spacing="10">
                <GridPane fx:id="cartGridPane" prefWidth="1024" prefHeight="760" style="-fx-border-color: #cccccc; -fx-border-width: 1;"/>
            </VBox>
        </ScrollPane>
    </center>
    
    <bottom>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #f0f0f0;">
            <Separator/>
            
            <!-- Summary Section -->
            <HBox spacing="20" style="-fx-alignment: center-right;">
                <Label text="Subtotal:" style="-fx-font-size: 12;"/>
                <Label fx:id="subtotalLabel" text="$0.00" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                
                <Label text="Tax:" style="-fx-font-size: 12;"/>
                <Label fx:id="taxLabel" text="$0.00" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                
                <Label text="Total:" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                <Label fx:id="totalLabel" text="$0.00" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #ff0000;"/>
            </HBox>
            
            <!-- Buttons Section -->
            <HBox spacing="10" style="-fx-alignment: center;">
                <Button text="Continue Shopping" onAction="#continueShopping" style="-fx-padding: 10; -fx-font-size: 12;"/>
                <Button text="Clear Cart" onAction="#clearCart" style="-fx-padding: 10; -fx-font-size: 12;"/>
                <Button text="Checkout" onAction="#checkout" style="-fx-padding: 10; -fx-font-size: 12; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Exit" onAction="#exit" style="-fx-padding: 10; -fx-font-size: 12;"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
