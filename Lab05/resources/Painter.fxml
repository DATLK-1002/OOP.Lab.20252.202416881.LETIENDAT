<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Slider?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hust.soict.elitech.gui.PainterController">
    <left>
        <VBox spacing="10" style="-fx-padding: 15; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">
            <Label text="Drawing Tools" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            
            <!-- Clear Button -->
            <Button text="Clear" onAction="#clearButtonPressed" style="-fx-padding: 8; -fx-font-size: 12;"/>
            
            <!-- Color Picker -->
            <Label text="Color:" style="-fx-font-size: 12;"/>
            <ColorPicker fx:id="colorPicker" onAction="#onColorChanged"/>
            
            <!-- Stroke Width Slider -->
            <Label text="Stroke Width:" style="-fx-font-size: 12;"/>
            <Slider fx:id="strokeWidthSlider" min="1" max="20" value="2" onMouseReleased="#onStrokeWidthChanged"/>
            <Label fx:id="strokeWidthLabel" text="2.0" style="-fx-font-size: 10;"/>
            
            <!-- Undo/Redo Buttons -->
            <Button text="Undo" onAction="#undoButtonPressed" style="-fx-padding: 8; -fx-font-size: 12;"/>
            <Button text="Redo" onAction="#redoButtonPressed" style="-fx-padding: 8; -fx-font-size: 12;"/>
        </VBox>
    </left>
    
    <center>
        <Pane fx:id="drawingAreaPane" style="-fx-border-color: #000000; -fx-border-width: 1;" 
              onMousePressed="#drawingAreaMousePressed" 
              onMouseDragged="#drawingAreaMouseDragged"
              onMouseReleased="#drawingAreaMouseReleased"/>
    </center>
</BorderPane>
